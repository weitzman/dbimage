#!/bin/bash

## Description: Reset the db service, reloading data from the cached DB image.
## Usage: resetdb
## Example: "ddev resetdb"

set -eu -o pipefail

# --reset-database removes the db container and database volume; the stock
# entrypoint then restores the pinned image's baked seed
# (/mysqlbase/custom/base_db.zst) into the recreated empty volume.
ddev start --reset-database --omit-snapshot --skip-confirmation