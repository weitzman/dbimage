#!/bin/bash

## Description: Reset the db service, fetching a newer DB image if available.
## Usage: pulldb [tag]
## Example: "ddev pulldb" or "ddev pulldb 2026-07-15"

set -eu -o pipefail

tag=${1:-latest}
image="ghcr.io/montefiore-einstein/metrialsvc/database:${tag}"
config="${DDEV_APPROOT}/.ddev/config.yaml"

docker pull "${image}"

# Point the tracked dbimage setting at the requested image. A non-default
# pin keeps config.yaml dirty — visible in `git status` and on every
# `ddev start` — until a plain `ddev pulldb` (or git checkout) restores
# the committed default. The line is edited in place because `ddev config
# --db-image` rewrites the whole file, dropping its comments.
grep -q '^dbimage:' "${config}"
perl -pi -e "s|^dbimage:.*|dbimage: ${image}|" "${config}"

# --reset-database removes the db container and database volume. The
# freshly pulled image invalidates DDEV's derived-image build cache, so
# start rebuilds only the thin user-setup layer, and the stock entrypoint
# restores the image's baked seed into the recreated empty volume.
ddev start --reset-database --omit-snapshot --skip-confirmation
